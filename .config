# ==========================================
# 目标硬件平台：MediaTek MT7620 / 斐讯 PSG1208 (K1)
# ==========================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_phicomm_psg1208=y

# ==========================================
# Web 图形管理界面 (LuCI) 与中文支持
# ==========================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ==========================================
# 校园网自动登录必备工具 (支持网页 POST / 自动重连)
# ==========================================
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

# ==========================================
# 校园网多设备防检测核心组件
# ==========================================
# 1. TTL 锁定支持
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_kmod-ipt-ipopt=y

# 2. UA 统一伪装 (ua2f 及网页控制台)
CONFIG_PACKAGE_ua2f=y
CONFIG_PACKAGE_luci-app-ua2f=y

# 3. IPID 混淆模块 (防止时序指纹检测)
CONFIG_PACKAGE_kmod-rkp-ipid=y
